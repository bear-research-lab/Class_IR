<!--
  Pipetting task scene. The RB5 and hand are attached in Python (rb5_sim/env.py),
  which also moves the holder, water source and beaker to the chosen layout and
  applies the holder pose error.

  The robot and all task objects stand on a lab bench whose top is z = 0.
  Everything below and around the bench (floor, walls, shelf, bottles) is
  visual only and does not collide.
-->
<mujoco model="pipetting task">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <statistic center="0.4 0 0.3" extent="1.0"/>

  <visual>
    <headlight diffuse="0.35 0.35 0.35" ambient="0.35 0.35 0.36" specular="0 0 0"/>
    <rgba haze="0.93 0.94 0.95 1"/>
    <quality shadowsize="4096"/>
    <map znear="0.01"/>
    <global azimuth="160" elevation="-25" offwidth="1280" offheight="720"/>
  </visual>

  <default>
    <default class="decor">
      <geom type="box" contype="0" conaffinity="0" group="0"/>
    </default>
    <default class="glass">
      <geom type="box" rgba="0.75 0.85 0.95 0.35" friction="0.6"/>
    </default>
    <!-- Compliant bulb wall: a rubber segment on a radial spring. Compression q (m)
         gives a squeeze force of stiffness * q; at range max the bulb is flat.
         contype=2/conaffinity=1: walls touch the hand and the world, not each other. -->
    <default class="bulb_wall">
      <joint type="slide" stiffness="600" damping="1" armature="0.01" range="0 0.006"/>
      <geom type="capsule" fromto="0 0 -0.009 0 0 0.009" size="0.004" mass="0.002"
            contype="2" conaffinity="1" condim="4" friction="1.5 0.02 0.001" rgba="0.96 0.62 0.45 1"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.96 0.96 0.97" rgb2="0.86 0.87 0.89" width="512" height="3072"/>
    <texture type="2d" name="vinyl" builtin="checker" rgb1="0.80 0.81 0.82" rgb2="0.76 0.77 0.79"
             width="512" height="512"/>
    <material name="vinyl" texture="vinyl" texuniform="true" texrepeat="3 3" reflectance="0.05"/>
    <material name="benchtop" rgba="0.36 0.39 0.42 1" specular="0.35" shininess="0.5" reflectance="0.03"/>
    <material name="steel" rgba="0.62 0.64 0.67 1" specular="0.6" shininess="0.7"/>
    <material name="cabinet" rgba="0.95 0.95 0.94 1" specular="0.2"/>
    <material name="wall" rgba="0.93 0.93 0.91 1" specular="0"/>
    <material name="trim" rgba="0.55 0.62 0.70 1" specular="0.2"/>
  </asset>

  <worldbody>
    <light name="ceiling_1" pos="0.3 -0.8 2.4" dir="0 0.3 -1" diffuse="0.55 0.55 0.53" specular="0.1 0.1 0.1"
           castshadow="true" cutoff="70" exponent="2"/>
    <light name="ceiling_2" pos="0.3 0.8 2.4" dir="0 -0.3 -1" diffuse="0.45 0.45 0.44" specular="0.1 0.1 0.1"
           castshadow="false" cutoff="70" exponent="2"/>

    <!-- Lab bench: the top surface is z = 0 and is the only collidable part. -->
    <geom name="bench_top" type="box" size="0.9 0.75 0.02" pos="0.25 0 -0.02" material="benchtop"/>
    <geom class="decor" size="0.9 0.012 0.01" pos="0.25 -0.762 -0.03" material="steel"/>
    <geom class="decor" size="0.9 0.012 0.01" pos="0.25 0.762 -0.03" material="steel"/>
    <geom class="decor" size="0.85 0.7 0.4" pos="0.25 0 -0.46" material="cabinet"/>
    <geom class="decor" size="0.003 0.34 0.38" pos="1.103 -0.35 -0.46" material="cabinet"/>
    <geom class="decor" size="0.003 0.34 0.38" pos="1.103 0.35 -0.46" material="cabinet"/>
    <geom class="decor" size="0.006 0.06 0.008" pos="1.11 -0.06 -0.15" material="steel"/>
    <geom class="decor" size="0.006 0.06 0.008" pos="1.11 0.06 -0.15" material="steel"/>
    <geom class="decor" size="0.84 0.69 0.04" pos="0.25 0 -0.86" rgba="0.3 0.31 0.33 1"/>

    <!-- Room: vinyl floor, walls with a colored trim band, a wall shelf with bottles. -->
    <geom name="lab_floor" type="plane" size="4 4 0.05" pos="0 0 -0.9" material="vinyl" contype="0" conaffinity="0"/>
    <geom class="decor" size="0.02 4 1.6" pos="-1.4 0 0.7" material="wall"/>
    <geom class="decor" size="4 0.02 1.6" pos="0 2.2 0.7" material="wall"/>
    <geom class="decor" size="4 0.02 1.6" pos="0 -2.2 0.7" material="wall"/>
    <geom class="decor" size="0.021 4 0.05" pos="-1.4 0 -0.8" material="trim"/>
    <geom class="decor" size="4 0.021 0.05" pos="0 2.2 -0.8" material="trim"/>
    <geom class="decor" size="4 0.021 0.05" pos="0 -2.2 -0.8" material="trim"/>
    <geom class="decor" size="0.12 0.9 0.012" pos="-1.26 0 0.75" material="steel"/>
    <geom class="decor" size="0.12 0.9 0.012" pos="-1.26 0 1.15" material="steel"/>
    <geom class="decor" type="cylinder" size="0.045 0.09" pos="-1.28 -0.6 0.852" rgba="0.55 0.35 0.2 0.85"/>
    <geom class="decor" type="cylinder" size="0.035 0.07" pos="-1.28 -0.45 0.832" rgba="0.92 0.94 0.96 0.9"/>
    <geom class="decor" type="cylinder" size="0.04 0.1" pos="-1.28 -0.25 0.862" rgba="0.2 0.45 0.75 0.8"/>
    <geom class="decor" type="cylinder" size="0.03 0.06" pos="-1.28 0.2 0.822" rgba="0.9 0.9 0.92 0.9"/>
    <geom class="decor" type="cylinder" size="0.045 0.09" pos="-1.28 0.4 0.852" rgba="0.55 0.35 0.2 0.85"/>
    <geom class="decor" type="cylinder" size="0.04 0.08" pos="-1.28 -0.4 1.242" rgba="0.92 0.94 0.96 0.9"/>
    <geom class="decor" type="cylinder" size="0.05 0.1" pos="-1.28 0.1 1.262" rgba="0.3 0.6 0.4 0.8"/>
    <geom class="decor" size="0.06 0.12 0.08" pos="-1.28 0.55 1.242" rgba="0.85 0.86 0.88 1"/>

    <!-- Pipette holder: 50x50x60 mm block with a 40 mm deep square socket. Only the
         base is defined here; env.py adds the socket walls, sized to the pipette shaft
         (+1 mm clearance) with a small 45 deg lead-in chamfer at the top.
         The pipette tip rests on the socket floor at z = 0.02 in the holder frame. -->
    <body name="holder">
      <geom name="holder_base" type="box" size="0.025 0.025 0.01" pos="0 0 0.01" rgba="0.78 0.74 0.66 1" friction="0.3"/>
      <site name="holder_seat" pos="0 0 0.02" size="0.003" rgba="1 0.5 0 1" group="1"/>
    </body>

    <!-- Pipette: frame at the tip, +z along the shaft toward the bulb.
         Shaft r = 4 mm, 160 mm long; bulb r = 9 mm centered 180 mm above the tip.
         The bulb is four spring-loaded walls (+x, -x, +y, -y) around a rigid core,
         so squeezing it from any of those sides compresses it.
         Instead of a free joint the pipette has 3 slides + 2 tilt hinges: it moves and
         tilts freely but cannot spin about its own axis. A real bulb is round, so that
         spin changes nothing; locking it keeps the 4-wall bulb facing the same way. -->
    <body name="pipette">
      <joint name="pipette_x" type="slide" axis="1 0 0"/>
      <joint name="pipette_y" type="slide" axis="0 1 0"/>
      <joint name="pipette_z" type="slide" axis="0 0 1"/>
      <joint name="pipette_tilt_x" type="hinge" axis="1 0 0"/>
      <joint name="pipette_tilt_y" type="hinge" axis="0 1 0"/>
      <inertial pos="0 0 0.1" mass="0.02" diaginertia="8e-5 8e-5 2e-7"/>
      <geom name="shaft" type="capsule" fromto="0 0 0.004 0 0 0.16" size="0.004"
            rgba="0.85 0.92 0.98 0.6" friction="0.3 0.02 0.001" condim="4"/>
      <geom name="bulb_core" type="capsule" fromto="0 0 0.172 0 0 0.188" size="0.006"
            contype="0" conaffinity="0" rgba="0.96 0.62 0.45 1"/>
      <site name="tip" pos="0 0 0" size="0.002" rgba="1 0 0 1"/>

      <body name="bulb_wall_px" pos=" 0.005 0 0.18">
        <joint name="bulb_px" class="bulb_wall" axis="-1 0 0"/>
        <geom class="bulb_wall"/>
      </body>
      <body name="bulb_wall_nx" pos="-0.005 0 0.18">
        <joint name="bulb_nx" class="bulb_wall" axis="1 0 0"/>
        <geom class="bulb_wall"/>
      </body>
      <body name="bulb_wall_py" pos="0  0.005 0.18">
        <joint name="bulb_py" class="bulb_wall" axis="0 -1 0"/>
        <geom class="bulb_wall"/>
      </body>
      <body name="bulb_wall_ny" pos="0 -0.005 0.18">
        <joint name="bulb_ny" class="bulb_wall" axis="0 1 0"/>
        <geom class="bulb_wall"/>
      </body>
    </body>

    <!-- Water source: open tank, inner 120x120 mm, 80 mm tall, water 50 mm deep (visual only). -->
    <body name="water_source">
      <geom class="glass" size="0.065 0.065 0.0025" pos="0 0 0.0025"/>
      <geom class="glass" size="0.0025 0.065 0.04" pos=" 0.0625 0 0.04"/>
      <geom class="glass" size="0.0025 0.065 0.04" pos="-0.0625 0 0.04"/>
      <geom class="glass" size="0.06 0.0025 0.04" pos="0  0.0625 0.04"/>
      <geom class="glass" size="0.06 0.0025 0.04" pos="0 -0.0625 0.04"/>
      <geom name="water" type="box" size="0.06 0.06 0.0225" pos="0 0 0.0275"
            contype="0" conaffinity="0" rgba="0.3 0.6 0.95 0.4"/>
    </body>

    <!-- Beaker: open container, inner 80x80 mm, 100 mm tall. -->
    <body name="beaker">
      <geom class="glass" size="0.045 0.045 0.0025" pos="0 0 0.0025"/>
      <geom class="glass" size="0.0025 0.045 0.05" pos=" 0.0425 0 0.05"/>
      <geom class="glass" size="0.0025 0.045 0.05" pos="-0.0425 0 0.05"/>
      <geom class="glass" size="0.04 0.0025 0.05" pos="0  0.0425 0.05"/>
      <geom class="glass" size="0.04 0.0025 0.05" pos="0 -0.0425 0.05"/>
    </body>
  </worldbody>

  <sensor>
    <!-- bulb wall compression (m); squeeze force = wall stiffness * compression -->
    <jointpos name="bulb_px" joint="bulb_px"/>
    <jointpos name="bulb_nx" joint="bulb_nx"/>
    <jointpos name="bulb_py" joint="bulb_py"/>
    <jointpos name="bulb_ny" joint="bulb_ny"/>
  </sensor>
</mujoco>
